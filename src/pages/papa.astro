---
const title = 'Feliz cumpleaños Papaute';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#17130f" />
    <meta name="description" content="Una felicitación animada para Papaute." />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: system-ui, sans-serif;
        background: #171325;
        color: #fff3f7;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      * { box-sizing: border-box; }

      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
        overflow-x: hidden;
        background:
          radial-gradient(ellipse at 50% 0%, #39203c 0%, transparent 54%),
          linear-gradient(160deg, #21192c, #100f1b 72%);
      }

      main {
        width: min(100% - 2rem, 1080px);
        margin: 0 auto;
        padding: clamp(2rem, 7vh, 5rem) 0 2rem;
        text-align: center;
      }

      .eyebrow {
        margin: 0 0 .8rem;
        color: #ffb1cb;
        font: 700 .72rem/1.4 ui-monospace, monospace;
        letter-spacing: .24em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        color: #fff3f7;
        font-size: clamp(2.4rem, 8vw, 5.7rem);
        line-height: .98;
        letter-spacing: -.065em;
        text-wrap: balance;
        text-shadow: 0 5px 35px #f36a9940;
      }

      h1 span {
        display: block;
        color: #ffb4cc;
      }

      .intro {
        margin: 1rem auto 1.8rem;
        color: #c8bbd5;
        font-size: clamp(.95rem, 2vw, 1.08rem);
      }

      .scene {
        position: relative;
        overflow: hidden;
        border: 1px solid #f39aba40;
        border-radius: 1.2rem;
        background: #13101be8;
        box-shadow: 0 30px 100px #0008, inset 0 1px #fff2;
      }

      .scene::before {
        position: absolute;
        z-index: 1;
        inset: 0;
        pointer-events: none;
        content: "";
        background: radial-gradient(#ffffff16 .7px, transparent .7px);
        background-size: 7px 7px;
        opacity: .12;
      }

      canvas {
        display: block;
        width: 100%;
        height: clamp(390px, 58vw, 620px);
        cursor: crosshair;
        touch-action: manipulation;
      }

      .scene-label {
        position: absolute;
        z-index: 2;
        bottom: .9rem;
        left: 50%;
        transform: translateX(-50%);
        color: #f6c2d5;
        font: 600 .68rem/1 ui-monospace, monospace;
        letter-spacing: .14em;
        text-transform: uppercase;
        opacity: .78;
        white-space: nowrap;
        pointer-events: none;
      }

      .controls {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: .75rem;
        margin: 1.2rem 0 .8rem;
      }

      button {
        min-height: 46px;
        padding: .7rem 1.15rem;
        border: 1px solid #ff9fbd70;
        border-radius: 999px;
        background: #f16d9820;
        color: #fff3f7;
        font: 650 .9rem/1.2 system-ui, sans-serif;
        cursor: pointer;
        transition: transform .2s ease, background .2s ease, border-color .2s ease;
      }

      button:hover {
        transform: translateY(-2px);
        border-color: #ff9fbd;
        background: #f16d9838;
      }

      button:focus-visible, canvas:focus-visible {
        outline: 3px solid #8ae6ce;
        outline-offset: 4px;
      }

      .sound-button[aria-pressed="true"] {
        border-color: #8ae6ce;
        background: #48b9a52b;
      }

      .hint, #audio-status {
        min-height: 1.4em;
        margin: .55rem 0 0;
        color: #c2b5d0;
        font-size: .82rem;
      }

      .hint kbd {
        padding: .12rem .35rem;
        border: 1px solid #ffffff30;
        border-radius: .3rem;
        color: #f3d9e3;
        font: inherit;
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          scroll-behavior: auto !important;
          transition-duration: .01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <p class="eyebrow">La obra más bonita de todas</p>
      <h1>Feliz cumpleaños <span>Papaute</span></h1>
      <p class="intro">Cinco corazones, una familia y un montón de amor para celebrar a papá.</p>

      <div class="scene">
        <span class="scene-label" aria-hidden="true">Una familia construida con amor</span>
        <canvas
          id="workshop"
          role="img"
          aria-label="Un corazón luminoso que gira alrededor de Elena, Adrián, papá con corona, mamá y Juan. Pulsa o haz clic para lanzar destellos."
          tabindex="0"
        ></canvas>
      </div>

      <div class="controls">
        <button id="party" type="button">¡Lluvia de amor! ✨</button>
        <button id="sound" class="sound-button" type="button" aria-pressed="false">♫ Poner música</button>
      </div>
      <p class="hint">Toca el corazón o pulsa <kbd>Enter</kbd> para llenarlo de destellos.</p>
      <p class="hint">Mamá es la más alta; Juan mide 10 cm más que Papá.</p>
      <p class="hint">La mejor obra de tu vida es esta familia. ¡Te queremos, Papá!</p>
      <p id="audio-status" role="status" aria-live="polite"></p>
    </main>

    <script>
      const canvas = document.querySelector('#workshop');
      const context = canvas.getContext('2d');
      const partyButton = document.querySelector('#party');
      const soundButton = document.querySelector('#sound');
      const audioStatus = document.querySelector('#audio-status');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const palette = ['#ffb1cb', '#ffcf83', '#a8eadf', '#d6b3ff', '#fff3f7'];
      const particles = [];
      let frame = 0;
      let celebrationUntil = 0;
      let audioContext;
      let audioTimer;
      let audioNodes = [];
      let masterGain;

      function resizeCanvas() {
        const bounds = canvas.getBoundingClientRect();
        const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(bounds.width * pixelRatio);
        canvas.height = Math.round(bounds.height * pixelRatio);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      }

      function heartPath() {
        context.beginPath();
        context.moveTo(0, -118);
        context.bezierCurveTo(-132, -260, -362, -178, 0, 188);
        context.bezierCurveTo(362, -178, 132, -260, 0, -118);
        context.closePath();
      }

      function celebrate(x, y) {
        celebrationUntil = performance.now() + 1800;
        for (let i = 0; i < 48; i += 1) {
          const angle = Math.random() * Math.PI * 2;
          const speed = .12 + Math.random() * .28;
          particles.push({
            x, y, vx: Math.cos(angle) * speed * 7, vy: Math.sin(angle) * speed * 7 - 1.5,
            life: 45 + Math.random() * 35, size: 2 + Math.random() * 4,
            color: palette[Math.floor(Math.random() * palette.length)],
          });
        }
      }

      function drawPerson(x, ground, unit, person, time) {
        const height = unit * person.height;
        const top = ground - height;
        const headRadius = unit * person.head;
        const headY = top + headRadius + unit * .12;
        const shoulderY = headY + headRadius + unit * .08;
        const waistY = ground - unit * .92;
        const bodyWidth = unit * person.width;
        const bob = Math.sin(time / 420 + person.phase) * unit * .018;

        context.save();
        context.translate(0, bob);
        context.fillStyle = '#08071348';
        context.beginPath();
        context.ellipse(x, ground + unit * .04, bodyWidth * .95, unit * .1, 0, 0, Math.PI * 2);
        context.fill();

        context.lineCap = 'round';
        context.lineJoin = 'round';
        context.strokeStyle = person.pants;
        context.lineWidth = unit * .2;
        context.beginPath();
        context.moveTo(x - bodyWidth * .2, waistY);
        context.lineTo(x - bodyWidth * .25, ground - unit * .16);
        context.moveTo(x + bodyWidth * .2, waistY);
        context.lineTo(x + bodyWidth * .25, ground - unit * .16);
        context.stroke();
        context.fillStyle = person.shoes;
        context.beginPath();
        context.ellipse(x - bodyWidth * .34, ground - unit * .1, unit * .2, unit * .09, -.12, 0, Math.PI * 2);
        context.ellipse(x + bodyWidth * .34, ground - unit * .1, unit * .2, unit * .09, .12, 0, Math.PI * 2);
        context.fill();

        context.fillStyle = person.clothes;
        context.beginPath();
        context.roundRect(x - bodyWidth * .5, shoulderY, bodyWidth, waistY - shoulderY, unit * .22);
        context.fill();
        context.fillStyle = person.accent;
        context.fillRect(x - unit * .035, shoulderY + unit * .08, unit * .07, waistY - shoulderY - unit * .16);

        context.strokeStyle = person.skin;
        context.lineWidth = unit * .14;
        context.beginPath();
        context.moveTo(x - bodyWidth * .43, shoulderY + unit * .12);
        context.lineTo(x - bodyWidth * .75, shoulderY + unit * .6);
        context.lineTo(x - bodyWidth * .48, waistY - unit * .05);
        context.moveTo(x + bodyWidth * .43, shoulderY + unit * .12);
        context.lineTo(x + bodyWidth * .73, shoulderY + unit * .56 + Math.sin(time / 300 + person.phase) * unit * .1);
        context.lineTo(x + bodyWidth * .48, waistY - unit * .05);
        context.stroke();
        context.fillStyle = person.accent;
        context.beginPath();
        context.arc(x - bodyWidth * .48, waistY - unit * .05, unit * .08, 0, Math.PI * 2);
        context.arc(x + bodyWidth * .48, waistY - unit * .05, unit * .08, 0, Math.PI * 2);
        context.fill();

        context.fillStyle = person.skin;
        context.beginPath();
        context.roundRect(x - unit * .105, headY + headRadius * .72, unit * .21, unit * .28, unit * .06);
        context.fill();
        context.beginPath();
        context.arc(x, headY, headRadius, 0, Math.PI * 2);
        context.fill();

        context.fillStyle = person.hair;
        context.beginPath();
        context.arc(x, headY - headRadius * .09, headRadius * 1.04, Math.PI, Math.PI * 2);
        context.quadraticCurveTo(x + headRadius, headY + headRadius * .28, x + headRadius * .72, headY + headRadius * .58);
        context.lineTo(x + headRadius * .56, headY + headRadius * .05);
        context.lineTo(x, headY + headRadius * .22);
        context.lineTo(x - headRadius * .58, headY + headRadius * .03);
        context.lineTo(x - headRadius * .7, headY + headRadius * .56);
        context.quadraticCurveTo(x - headRadius, headY + headRadius * .25, x - headRadius, headY);
        context.fill();

        context.fillStyle = '#332333';
        context.beginPath();
        context.arc(x - headRadius * .34, headY + headRadius * .04, Math.max(1.5, unit * .025), 0, Math.PI * 2);
        context.arc(x + headRadius * .34, headY + headRadius * .04, Math.max(1.5, unit * .025), 0, Math.PI * 2);
        context.fill();
        context.strokeStyle = '#9b4e56';
        context.lineWidth = Math.max(1.5, unit * .025);
        context.beginPath();
        context.arc(x, headY + headRadius * .2, headRadius * .28, .2, Math.PI - .2);
        context.stroke();

        if (person.beard) {
          context.fillStyle = person.hair;
          context.beginPath();
          context.arc(x, headY + headRadius * .48, headRadius * .66, 0, Math.PI);
          context.fill();
          context.fillStyle = person.skin;
          context.fillRect(x - headRadius * .42, headY + headRadius * .48, headRadius * .84, headRadius * .14);
        }

        if (person.crown) {
          const crownY = headY - headRadius * 1.12;
          context.shadowColor = '#ffd36e';
          context.shadowBlur = unit * .16;
          context.fillStyle = '#ffd36e';
          context.beginPath();
          context.moveTo(x - headRadius * .78, crownY + headRadius * .72);
          context.lineTo(x - headRadius * .68, crownY);
          context.lineTo(x - headRadius * .24, crownY + headRadius * .38);
          context.lineTo(x, crownY - headRadius * .14);
          context.lineTo(x + headRadius * .25, crownY + headRadius * .38);
          context.lineTo(x + headRadius * .7, crownY);
          context.lineTo(x + headRadius * .8, crownY + headRadius * .72);
          context.closePath();
          context.fill();
          context.shadowBlur = 0;
          context.fillStyle = '#fff5c9';
          context.beginPath();
          context.arc(x - headRadius * .5, crownY + headRadius * .34, unit * .035, 0, Math.PI * 2);
          context.arc(x, crownY + headRadius * .15, unit * .035, 0, Math.PI * 2);
          context.arc(x + headRadius * .5, crownY + headRadius * .34, unit * .035, 0, Math.PI * 2);
          context.fill();
        }

        if (person.toolbelt) {
          context.fillStyle = '#e0aa5a';
          context.fillRect(x - bodyWidth * .48, waistY - unit * .08, bodyWidth * .96, unit * .12);
          context.fillStyle = '#f6d17b';
          context.beginPath();
          context.roundRect(x + bodyWidth * .27, waistY - unit * .01, unit * .18, unit * .2, unit * .04);
          context.fill();
        }

        context.restore();

        context.fillStyle = '#fff4f8';
        context.font = `700 ${Math.max(11, unit * .19)}px system-ui, sans-serif`;
        context.textAlign = 'center';
        context.fillText(person.name, x, ground + unit * .2);
        context.fillStyle = '#d7c5df';
        context.font = `500 ${Math.max(9, unit * .125)}px system-ui, sans-serif`;
        context.fillText(person.role, x, ground + unit * .43);
        context.textAlign = 'start';
      }

      const family = [
        { name: 'Elena', role: 'hija', at: .21, height: 2.55, head: .27, width: .72, clothes: '#ec83ac', accent: '#ffd0de', pants: '#865889', skin: '#e9b18f', hair: '#573746', shoes: '#573746', phase: 0 },
        { name: 'Adrián', role: 'hijo', at: .355, height: 2.85, head: .28, width: .76, clothes: '#65b9c9', accent: '#dbf0d0', pants: '#43567c', skin: '#d99d79', hair: '#493b37', shoes: '#493b37', phase: 1 },
        { name: 'Papá', role: 'rey de hoy', at: .50, height: 3.46, head: .275, width: .82, clothes: '#dc8f71', accent: '#f5d6a0', pants: '#51506b', skin: '#d99e7e', hair: '#77727a', shoes: '#393342', phase: 2, crown: true, beard: true, toolbelt: true },
        { name: 'Mamá', role: 'más alta', at: .645, height: 4.02, head: .255, width: .72, clothes: '#9b79c9', accent: '#f4c8dd', pants: '#684c88', skin: '#e7b69a', hair: '#493548', shoes: '#493548', phase: 3 },
        { name: 'Juan', role: 'hermano', at: .79, height: 3.68, head: .27, width: .8, clothes: '#66a889', accent: '#d3e8b3', pants: '#465d65', skin: '#d99e7e', hair: '#433735', shoes: '#343139', phase: 4, beard: true },
      ];

      function draw() {
        const bounds = canvas.getBoundingClientRect();
        const width = bounds.width;
        const height = bounds.height;
        const now = performance.now();
        frame += 1;
        context.clearRect(0, 0, width, height);
        context.fillStyle = '#151221';
        context.fillRect(0, 0, width, height);

        const glow = context.createRadialGradient(width / 2, height * .48, 0, width / 2, height * .48, width * .58);
        glow.addColorStop(0, '#71365370');
        glow.addColorStop(1, '#15122100');
        context.fillStyle = glow;
        context.fillRect(0, 0, width, height);

        const unit = Math.min(width * .078, height * .155);
        const ground = height * .78;
        const heartScale = Math.min(width / 830, height / 550);
        const heartY = height * .51;
        const rotation = reducedMotion.matches ? 0 : frame * .004;

        context.save();
        context.translate(width / 2, heartY);
        context.rotate(rotation);
        context.scale(heartScale, heartScale);
        heartPath();
        const heartGradient = context.createLinearGradient(-230, -220, 230, 190);
        heartGradient.addColorStop(0, '#ffb8d0');
        heartGradient.addColorStop(.48, '#fb6f9c');
        heartGradient.addColorStop(1, '#ffc477');
        context.shadowColor = '#ff6f9f';
        context.shadowBlur = 28;
        context.strokeStyle = heartGradient;
        context.lineWidth = 7;
        context.stroke();
        context.shadowBlur = 0;
        heartPath();
        context.globalAlpha = .12;
        context.fillStyle = heartGradient;
        context.fill();
        context.globalAlpha = 1;
        context.restore();

        // A faint wall-frame and measuring marks nod to Papaute's trade.
        context.save();
        context.strokeStyle = '#f4ce9742';
        context.lineWidth = 1;
        context.beginPath();
        context.moveTo(width * .06, ground + unit * .12);
        context.lineTo(width * .94, ground + unit * .12);
        context.moveTo(width * .1, ground + unit * .12);
        context.lineTo(width * .1, ground - unit * 1.5);
        context.moveTo(width * .9, ground + unit * .12);
        context.lineTo(width * .9, ground - unit * 1.5);
        context.moveTo(width * .1, ground - unit * 1.5);
        context.lineTo(width * .9, ground - unit * 1.5);
        context.stroke();
        for (let mark = 0; mark < 17; mark += 1) {
          const x = width * .1 + mark * width * .05;
          context.beginPath();
          context.moveTo(x, ground + unit * .12);
          context.lineTo(x, ground + unit * (mark % 4 === 0 ? .28 : .2));
          context.stroke();
        }
        context.restore();

        family.forEach((person) => {
          drawPerson(width * person.at, ground, unit, person, now);
        });

        for (let i = particles.length - 1; i >= 0; i -= 1) {
          const particle = particles[i];
          context.globalAlpha = Math.min(1, particle.life / 18);
          context.fillStyle = particle.color;
          context.shadowColor = particle.color;
          context.shadowBlur = 12;
          context.beginPath();
          context.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
          context.fill();
          particle.x += particle.vx;
          particle.y += particle.vy;
          particle.vy += .035;
          particle.life -= 1;
          if (particle.life <= 0) particles.splice(i, 1);
        }
        context.globalAlpha = 1;
        context.shadowBlur = 0;

        if (!reducedMotion.matches || particles.length) requestAnimationFrame(draw);
      }

      function startAudio() {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) {
          audioStatus.textContent = 'Este navegador no permite reproducir el ambiente musical.';
          return;
        }

        audioContext = audioContext || new AudioContextClass();
        audioContext.resume().then(() => {
          masterGain = audioContext.createGain();
          masterGain.gain.value = .045;
          masterGain.connect(audioContext.destination);
          audioNodes = [];
          const notes = [130.81, 164.81, 196, 261.63];
          notes.forEach((frequency, index) => {
            const oscillator = audioContext.createOscillator();
            const gain = audioContext.createGain();
            oscillator.type = index === 3 ? 'sine' : 'triangle';
            oscillator.frequency.value = frequency;
            gain.gain.value = index === 3 ? .17 : .1;
            oscillator.connect(gain);
            gain.connect(masterGain);
            oscillator.start();
            audioNodes.push(oscillator);
          });

          let noteIndex = 0;
          audioTimer = window.setInterval(() => {
            const oscillator = audioContext.createOscillator();
            const gain = audioContext.createGain();
            oscillator.type = 'sine';
            oscillator.frequency.value = [523.25, 659.25, 783.99, 659.25][noteIndex % 4];
            gain.gain.setValueAtTime(.0001, audioContext.currentTime);
            gain.gain.exponentialRampToValueAtTime(.12, audioContext.currentTime + .08);
            gain.gain.exponentialRampToValueAtTime(.0001, audioContext.currentTime + 1.1);
            oscillator.connect(gain);
            gain.connect(masterGain);
            audioNodes.push(oscillator);
            oscillator.addEventListener('ended', () => {
              audioNodes = audioNodes.filter((node) => node !== oscillator);
            }, { once: true });
            oscillator.start();
            oscillator.stop(audioContext.currentTime + 1.15);
            noteIndex += 1;
          }, 1250);
          soundButton.textContent = '♫ Silenciar música';
          soundButton.setAttribute('aria-pressed', 'true');
          audioStatus.textContent = 'Ambiente original activado.';
        }).catch(() => {
          audioStatus.textContent = 'No se pudo iniciar el audio. Prueba de nuevo con el botón.';
        });
      }

      function stopAudio() {
        window.clearInterval(audioTimer);
        audioNodes.forEach((node) => node.stop());
        masterGain?.disconnect();
        audioContext?.suspend();
        audioNodes = [];
        soundButton.textContent = '♫ Poner música';
        soundButton.setAttribute('aria-pressed', 'false');
        audioStatus.textContent = 'Ambiente musical pausado.';
      }

      canvas.addEventListener('pointerdown', (event) => {
        const bounds = canvas.getBoundingClientRect();
        celebrate(
          event.clientX - bounds.left,
          event.clientY - bounds.top,
        );
        if (reducedMotion.matches) requestAnimationFrame(draw);
      });
      canvas.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          const bounds = canvas.getBoundingClientRect();
          celebrate(bounds.width / 2, bounds.height * .4);
          if (reducedMotion.matches) requestAnimationFrame(draw);
        }
      });
      partyButton.addEventListener('click', () => {
        const bounds = canvas.getBoundingClientRect();
        celebrate(bounds.width / 2, bounds.height * .4);
        if (reducedMotion.matches) requestAnimationFrame(draw);
      });
      soundButton.addEventListener('click', () => {
        if (soundButton.getAttribute('aria-pressed') === 'true') stopAudio();
        else startAudio();
      });
      window.addEventListener('resize', () => {
        resizeCanvas();
        requestAnimationFrame(draw);
      });
      resizeCanvas();
      requestAnimationFrame(draw);
    </script>
  </body>
</html>
