---
const title = '¡Feliz cumpleaños, Papaute!';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#21132f" />
    <meta name="description" content="Una felicitación de cumpleaños para Papaute." />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: system-ui, sans-serif;
        color: #fff7fb;
        background: #21132f;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      * { box-sizing: border-box; }

      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
        overflow: hidden;
        background:
          radial-gradient(ellipse at 50% 24%, #603869 0%, transparent 43%),
          radial-gradient(ellipse at 10% 100%, #402d6e 0%, transparent 48%),
          linear-gradient(145deg, #21132f, #171a39);
      }

      main {
        position: relative;
        display: grid;
        min-height: 100svh;
        place-items: center;
        padding: 2rem 1rem;
        isolation: isolate;
      }

      .orb {
        position: absolute;
        z-index: -1;
        width: clamp(150px, 30vw, 310px);
        aspect-ratio: 1;
        border: 1px solid #ffffff13;
        border-radius: 50%;
        background: linear-gradient(145deg, #f8a5c51a, #9b8cff0a);
        box-shadow: 0 0 100px #c46dc51a, inset 0 0 50px #ffffff08;
        animation: float 8s ease-in-out infinite;
      }

      .orb::before, .orb::after {
        position: absolute;
        inset: 12%;
        border: 1px solid #ffffff0d;
        border-radius: 50%;
        content: "";
      }

      .orb::after { inset: 25%; }

      .card {
        width: min(100%, 620px);
        padding: clamp(1.7rem, 6vw, 3.5rem);
        border: 1px solid #ffffff24;
        border-radius: 2rem;
        background: linear-gradient(145deg, #ffffff12, #ffffff08);
        box-shadow: 0 30px 100px #09071470, inset 0 1px #ffffff20;
        text-align: center;
        backdrop-filter: blur(18px);
      }

      .eyebrow {
        margin: 0 0 .85rem;
        color: #f7b7da;
        font-size: .73rem;
        font-weight: 750;
        letter-spacing: .22em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.5rem, 9vw, 5rem);
        line-height: .98;
        letter-spacing: -.065em;
        text-wrap: balance;
      }

      h1 span {
        display: block;
        color: #ffc1dc;
        text-shadow: 0 0 36px #f389c758;
      }

      .message {
        max-width: 38ch;
        margin: 1rem auto 0;
        color: #e4d8ed;
        font-size: clamp(.98rem, 2.5vw, 1.1rem);
        line-height: 1.65;
      }

      .gift-note {
        margin: .55rem 0 0;
        color: #ffd46f;
        font-size: .95rem;
        font-weight: 650;
      }

      .cake {
        display: block;
        width: min(240px, 65vw);
        height: auto;
        margin: .4rem auto .3rem;
        overflow: visible;
        filter: drop-shadow(0 16px 24px #f390c12c);
      }

      .flame {
        transform-box: fill-box;
        transform-origin: center bottom;
        animation: flicker .8s ease-in-out infinite alternate;
      }

      .flame:nth-of-type(2) { animation-delay: -.3s; }
      .flame:nth-of-type(3) { animation-delay: -.55s; }
      .flame:nth-of-type(4) { animation-delay: -.18s; }
      .flame:nth-of-type(5) { animation-delay: -.42s; }

      .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: .75rem;
        margin-top: 1.5rem;
      }

      button {
        min-height: 46px;
        padding: .75rem 1.2rem;
        border: 1px solid #ffffff35;
        border-radius: 999px;
        background: #ffffff10;
        color: #fff7fb;
        font: 650 .92rem/1.2 system-ui, sans-serif;
        cursor: pointer;
        transition: transform .2s ease, background .2s ease, border-color .2s ease;
      }

      button:hover {
        transform: translateY(-2px);
        border-color: #ffc1dc;
        background: #ffffff1c;
      }

      .primary {
        border-color: #ffd1e1;
        background: linear-gradient(110deg, #f68dbb, #b995ff);
        color: #291533;
        box-shadow: 0 8px 26px #e689c23d;
      }

      .primary:hover { background: linear-gradient(110deg, #ffadd0, #c7aaff); }
      .sound[aria-pressed="true"] { border-color: #a9e8d2; }

      button:focus-visible {
        outline: 3px solid #a9e8d2;
        outline-offset: 4px;
      }

      .status {
        min-height: 1.4em;
        margin: .8rem 0 0;
        color: #c9b8d5;
        font-size: .82rem;
      }

      .confetti {
        position: fixed;
        z-index: 3;
        top: -1rem;
        left: var(--x);
        width: var(--size);
        height: calc(var(--size) * 1.5);
        border-radius: 2px;
        background: var(--color);
        pointer-events: none;
        animation: fall var(--duration) cubic-bezier(.2,.7,.3,1) forwards;
      }

      @keyframes float {
        0%, 100% { transform: translateY(-8px) rotate(-5deg); }
        50% { transform: translateY(8px) rotate(5deg); }
      }

      @keyframes flicker {
        from { transform: scale(.9, 1) rotate(-4deg); }
        to { transform: scale(1.08, .92) rotate(4deg); }
      }

      @keyframes fall {
        to { transform: translate3d(var(--drift), 110vh, 0) rotate(760deg); }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: .01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="orb" aria-hidden="true"></div>
      <section class="card" aria-labelledby="birthday-title">
        <p class="eyebrow">Hoy es un día para celebrar</p>
        <h1 id="birthday-title">¡Feliz cumpleaños<span>Papaute!</span></h1>
        <p class="message">Que este nuevo año venga lleno de alegría, buenos momentos y todo lo que te hace feliz.</p>
        <p class="gift-note">🎁 Pronto te llegan los regalos de tu hijo mayor.</p>

        <svg class="cake" viewBox="0 0 240 210" role="img" aria-label="Tarta de cumpleaños con cinco velas encendidas">
          <defs>
            <linearGradient id="icing" x1="0" x2="1" y1="0" y2="1">
              <stop offset="0" stop-color="#ffd1e1" />
              <stop offset="1" stop-color="#f69bc7" />
            </linearGradient>
            <linearGradient id="cake" x1="0" x2="1">
              <stop offset="0" stop-color="#ffbd87" />
              <stop offset="1" stop-color="#ef8f9e" />
            </linearGradient>
          </defs>
          <ellipse cx="120" cy="184" rx="91" ry="13" fill="#17132a" opacity=".6" />
          <path d="M37 145h166v28a13 13 0 0 1-13 13H50a13 13 0 0 1-13-13z" fill="url(#cake)" />
          <path d="M30 143a9 9 0 0 1 9-9h162a9 9 0 0 1 9 9v8H30z" fill="url(#icing)" />
          <path d="M60 106h120v30a10 10 0 0 1-10 10H70a10 10 0 0 1-10-10z" fill="#b995ff" />
          <path d="M53 105a8 8 0 0 1 8-8h118a8 8 0 0 1 8 8v7H53z" fill="#e2caff" />
          <path d="M79 73h82v25a9 9 0 0 1-9 9H88a9 9 0 0 1-9-9z" fill="#f3a5ce" />
          <path d="M73 72a7 7 0 0 1 7-7h80a7 7 0 0 1 7 7v7H73z" fill="#ffe0ec" />
          <g class="candles">
            <path d="M88 66V40M104 66V34M120 66V39M136 66V34M152 66V40" stroke="#fff4d2" stroke-linecap="round" stroke-width="5" />
            <path d="M88 62v-9M104 62v-9M120 62v-9M136 62v-9M152 62v-9" stroke="#f08db8" stroke-linecap="round" stroke-width="2" />
            <g fill="#ffd46f">
              <path class="flame" d="M88 35c-9-10 2-17 1-23 11 8 10 17 2 23z" />
              <path class="flame" d="M104 29c-9-10 2-17 1-23 11 8 10 17 2 23z" />
              <path class="flame" d="M120 34c-9-10 2-17 1-23 11 8 10 17 2 23z" />
              <path class="flame" d="M136 29c-9-10 2-17 1-23 11 8 10 17 2 23z" />
              <path class="flame" d="M152 35c-9-10 2-17 1-23 11 8 10 17 2 23z" />
            </g>
          </g>
          <g fill="#fff2b0">
            <circle cx="51" cy="158" r="3" /><circle cx="72" cy="124" r="3" />
            <circle cx="188" cy="158" r="3" /><circle cx="166" cy="124" r="3" />
            <circle cx="100" cy="169" r="3" /><circle cx="143" cy="169" r="3" />
          </g>
        </svg>

        <div class="actions">
          <button id="wish" class="primary" type="button">Pide un deseo ✨</button>
          <button id="music" class="sound" type="button" aria-pressed="false">♫ Poner música</button>
        </div>
        <p id="status" class="status" role="status" aria-live="polite"></p>
      </section>
    </main>

    <script>
      const wishButton = document.querySelector('#wish');
      const musicButton = document.querySelector('#music');
      const status = document.querySelector('#status');
      const colors = ['#ff8db8', '#ffd46f', '#a9e8d2', '#b995ff', '#fff4d2'];
      let audioContext;
      let masterGain;
      let oscillators = [];

      wishButton.addEventListener('click', () => {
        for (let i = 0; i < 72; i += 1) {
          const piece = document.createElement('span');
          piece.className = 'confetti';
          piece.setAttribute('aria-hidden', 'true');
          piece.style.setProperty('--x', `${Math.random() * 100}vw`);
          piece.style.setProperty('--size', `${5 + Math.random() * 7}px`);
          piece.style.setProperty('--color', colors[Math.floor(Math.random() * colors.length)]);
          piece.style.setProperty('--duration', `${2.2 + Math.random() * 1.8}s`);
          piece.style.setProperty('--drift', `${-100 + Math.random() * 200}px`);
          document.body.append(piece);
          window.setTimeout(() => piece.remove(), 4200);
        }
        status.textContent = '¡Deseo pedido! Que se cumpla todo lo bueno.';
      });

      musicButton.addEventListener('click', async () => {
        if (musicButton.getAttribute('aria-pressed') === 'true') {
          await audioContext.suspend();
          masterGain.gain.value = 0;
          musicButton.setAttribute('aria-pressed', 'false');
          musicButton.textContent = '♫ Poner música';
          status.textContent = 'Música pausada.';
          return;
        }

        const AudioContextClass = window.AudioContext;
        if (!AudioContextClass) {
          status.textContent = 'Este navegador no permite reproducir música.';
          return;
        }

        try {
          audioContext = audioContext || new AudioContextClass();
          await audioContext.resume();
          if (!masterGain) {
            masterGain = audioContext.createGain();
            masterGain.gain.value = .035;
            masterGain.connect(audioContext.destination);
            [130.81, 164.81, 196, 261.63].forEach((frequency, index) => {
              const oscillator = audioContext.createOscillator();
              const gain = audioContext.createGain();
              oscillator.type = index === 3 ? 'sine' : 'triangle';
              oscillator.frequency.value = frequency;
              gain.gain.value = index === 3 ? .14 : .1;
              oscillator.connect(gain);
              gain.connect(masterGain);
              oscillator.start();
              oscillators.push(oscillator);
            });
          }
          masterGain.gain.value = .035;
          musicButton.setAttribute('aria-pressed', 'true');
          musicButton.textContent = '♫ Silenciar música';
          status.textContent = 'Música original activada.';
        } catch {
          status.textContent = 'No se pudo iniciar la música. Inténtalo de nuevo.';
        }
      });
    </script>
  </body>
</html>
