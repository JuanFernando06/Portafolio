---
import '../styles/global.css';
import Projects from '../components/Projects.astro';
---
<!doctype html>
<html lang="es" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/webp" href="/logo.webp">
<title>Juan Fernando García Torrente — Desarrollador Full-Stack Junior</title>
<meta name="description" content="Portafolio de Juan Fernando García Torrente, Desarrollador Web Full-Stack Junior. Proyectos con Next.js, TypeScript, Supabase y Flutter.">
<meta property="og:title" content="Juan Fernando García Torrente — Desarrollador Full-Stack Junior">
<meta property="og:description" content="Portafolio de Juan Fernando García Torrente, Desarrollador Web Full-Stack Junior. Proyectos con Next.js, TypeScript, Supabase y Flutter.">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<meta property="og:image" content="/logo.webp">
<script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
<script is:inline defer src="/_vercel/insights/script.js"></script>
</head>
<body class="intro">
<a href="#sobre-mi" class="skip">Saltar al contenido</a>
<div id="cosmos"></div>
<canvas id="fx" aria-hidden="true"></canvas>
<!-- INTRO -->
<div id="intro">
  <div class="intro-top">
    <p class="eyebrow">Portafolio · Murcia, España</p>
    <h1>Juan Fernando<br>García Torrente</h1>
  </div>
  <div class="intro-bottom">
    <p class="lead" style="color:#d9f99d;max-width:34ch;margin:0 auto">
      Desarrollador Web Full-Stack Junior
    </p>
    <button id="enter" type="button">Entrar en el jardín <span aria-hidden="true">🌱</span></button>
    <p class="hint">Haz scroll o pulsa para explorar</p>
  </div>
</div>

<!-- HEADER -->
<header id="topbar">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8" aria-label="Navegación principal">
    <a href="#sobre-mi" class="flex items-center gap-3 no-underline">
      <span class="brand-logo">
        <img src="/logo.webp" alt="Logo PZukko">
      </span>
      <span class="font-bold tracking-tight" style="color:#f4ffd9">Juan Fernando</span>
    </a>
    <div class="hidden items-center gap-6 text-sm md:flex" style="color:#b6d094">
      <a href="#sobre-mi" class="transition hover:text-lime-300">Sobre mí</a>
      <a href="#proyectos" class="transition hover:text-lime-300">Proyectos</a>
      <a href="#stack" class="transition hover:text-lime-300">Stack</a>
      <a href="#trayectoria" class="transition hover:text-lime-300">Trayectoria</a>
      <a href="#contacto" class="transition hover:text-lime-300">Contacto</a>
    </div>
    <a href="/assets/cv.pdf" download class="btn btn-primary" style="padding:.55rem 1rem;font-size:.82rem">CV ↓</a>
  </nav>
</header>

<!-- RAIL -->
<nav id="rail" aria-label="Índice de secciones">
  <a href="#sobre-mi" data-rail="sobre-mi"><em>Sobre mí</em><span></span></a>
  <a href="#proyectos" data-rail="proyectos"><em>Proyectos</em><span></span></a>
  <a href="#stack" data-rail="stack"><em>Stack</em><span></span></a>
  <a href="#trayectoria" data-rail="trayectoria"><em>Trayectoria</em><span></span></a>
  <a href="#contacto" data-rail="contacto"><em>Contacto</em><span></span></a>
</nav>
<main>

  <!-- ============ SOBRE MÍ ============ -->
  <section id="sobre-mi" class="scene" data-cam="corona">
    <div class="scene-inner">
      <div class="panel reveal">
        <p class="kicker">Sobre mí</p>
        <h2 class="h-sec">Hola, soy Juan Fernando</h2>
        <p class="lead">
          Desarrollador Web Full-Stack Junior, titulado en <strong style="color:#d9f99d">DAW</strong>,
          con experiencia real en empresa construyendo aplicaciones internas con <strong style="color:#d9f99d">Next.js, TypeScript y Supabase</strong>.
        </p>
        <div class="flex flex-wrap gap-2 mt-4">
          <span class="tag">Murcia, España</span>
          <span class="tag">Full-Stack</span>
          <span class="tag">Flutter</span>
          <span class="tag">IA aplicada</span>
        </div>
        <div class="flex flex-wrap gap-3 mt-6">
          <a href="#proyectos" class="btn btn-primary">Ver proyectos</a>
          <a href="/assets/cv.pdf" download class="btn btn-ghost">Descargar CV</a>
        </div>
      </div>

      <div class="panel reveal">
        <p class="lead">
          Todo empezó en clase del instituto descubriendo Yuka. Me sorprendió la cantidad de aditivos
          ocultos que consumimos. Con los años me di cuenta de que la gente te mira raro cuando escaneas
          en el súper, y de ahí nació la idea de <strong style="color:#d9f99d">ZukkoNutri</strong>:
          hacer esa información accesible, visual y transparente.
        </p>
        <p class="lead mt-4">
          Me apasiona la resolución de problemas complejos y construir soluciones eficientes y elegantes.
          Disfruto trabajando en equipo, compartiendo lo que aprendo y explorando nuevas herramientas
          que mejoren el proceso de desarrollo y la experiencia del usuario final.
        </p>
        <div class="flex flex-wrap gap-2 mt-5">
          <span class="chip">Resolución de problemas</span>
          <span class="chip">Aprendizaje autodidacta</span>
          <span class="chip">Trabajo en equipo</span>
          <span class="chip">Desarrollo asistido por IA</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROYECTOS ============ -->
  <section id="proyectos" class="scene" data-cam="leafLeft" style="align-items:flex-start;padding-top:8rem">
    <div class="scene-inner" style="max-width:820px">
      <div class="panel reveal">
        <p class="kicker">Proyectos</p>
        <h2 class="h-sec">Cosas que he construido</h2>
        <p class="lead" style="font-size:.95rem">
          Cuatro proyectos reales, tres de ellos en producción o uso diario.
          Filtra por tipo: App/Web, solo apps o solo web.
        </p>
        <div class="filters" role="tablist" aria-label="Filtrar proyectos">
          <button class="filter active" data-filter="all" role="tab" aria-selected="true">Todos</button>
          <button class="filter" data-filter="appweb" role="tab" aria-selected="false">App/Web</button>
          <button class="filter" data-filter="app" role="tab" aria-selected="false">App</button>
          <button class="filter" data-filter="web" role="tab" aria-selected="false">Web</button>
        </div>
      </div>
      <Projects />
    </div>
  </section>

  <!-- ============ STACK ============ -->
  <section id="stack" class="scene" data-cam="stem">
    <div class="scene-inner">
      <div class="panel reveal">
        <p class="kicker">Stack</p>
        <h2 class="h-sec">Con qué trabajo</h2>
        <div class="stack-grid mt-5">
          <div class="stack-card">
            <h4>Web</h4>
            <p>Next.js · React · TypeScript · Node.js · HTML5 / CSS3 · Tailwind CSS</p>
          </div>
          <div class="stack-card">
            <h4>Backend y datos</h4>
            <p>Supabase · PostgreSQL · RLS · APIs REST · Auth · Git / GitHub</p>
          </div>
          <div class="stack-card">
            <h4>Mobile</h4>
            <p>Flutter · Dart · Riverpod · just_audio · Android nativo (Kotlin)</p>
          </div>
          <div class="stack-card">
            <h4>Herramientas e IA</h4>
            <p>Claude Code · Copilot · Groq AI · Power Apps · Power Automate · WordPress</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRAYECTORIA ============ -->
  <section id="trayectoria" class="scene" data-cam="leafRight">
    <div class="scene-inner">
      <div class="panel reveal">
        <p class="kicker">Experiencia</p>
        <h2 class="h-sec">Dónde he trabajado</h2>
        <ol class="tl">
          <li>
            <p class="mono text-xs" style="color:#bef264;margin:0 0 .2rem">Prácticas DAW · Murcia · 500 h</p>
            <h3 style="margin:0 0 .5rem;font-size:1.1rem;font-weight:700;color:#f8ffe8">Boca Te Lía — BlueCheck</h3>
            <ul class="proj-list">
              <li>Desarrollo de <strong>BlueCheck</strong> con Next.js, TypeScript y Supabase.</li>
              <li>Diseño de base de datos con relaciones y claves foráneas.</li>
              <li>Gestión de activos con códigos QR.</li>
              <li>Formularios y vistas para usuarios y administradores.</li>
              <li>Trabajo con datos reales de Excel, SharePoint y Supabase.</li>
              <li>Alertas por correo y Teams con Power Automate.</li>
              <li>Pruebas, corrección de bugs y documentación técnica.</li>
              <li>Despliegue en VM y producción con Git.</li>
            </ul>
          </li>
        </ol>
      </div>

      <div class="panel reveal">
        <p class="kicker">Educación e idiomas</p>
        <h2 class="h-sec">Formación</h2>
        <div class="mt-5 space-y-3">
          <div class="stack-card">
            <h4>Técnico Superior en DAW</h4>
            <p>IES Alcántara · Murcia · 2024 – 2026</p>
          </div>
          <div class="stack-card">
            <h4>Idiomas</h4>
            <p>Español — Nativo · Inglés — B1</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CONTACTO ============ -->
  <section id="contacto" class="scene" data-cam="roots">
    <div class="scene-inner" style="text-align:center">
      <div class="panel reveal">
        <p class="kicker">Raíces · Contacto</p>
        <h2 class="h-sec">¿Hablamos?</h2>
        <p class="lead mt-2" style="font-size:.98rem">
          Estoy abierto a oportunidades junior, prácticas y proyectos donde seguir creciendo.
        </p>
        <div class="flex flex-wrap justify-center gap-3 mt-6">
          <a href="mailto:juanfernandogt06@gmail.com" class="btn btn-primary">Email</a>
          <a href="https://github.com/JuanFernando06" target="_blank" rel="noopener" class="btn btn-ghost">GitHub</a>
          <a href="https://www.linkedin.com/in/juan-fernando" target="_blank" rel="noopener" class="btn btn-ghost">LinkedIn</a>
          <a href="tel:+34648687611" class="btn btn-ghost">Teléfono</a>
        </div>
        <p class="mono mt-6" style="font-size:.75rem;color:#7d9a68">
          Murcia, España · (+34) 648 687 611 · juanfernandogt06@gmail.com
        </p>
      </div>
    </div>
  </section>
</main>
<footer id="raices">
  <div class="roots-line" aria-hidden="true"></div>
  <p class="mono" style="font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:#7d9a68">
    Creciendo poco a poco, como una planta
  </p>
  <p class="mt-3" style="color:#90ab7b;font-size:.85rem">
    © <span id="year"></span> Juan Fernando García Torrente — Hecho con Astro.
  </p>
</footer>
<!-- LIGHTBOX -->
<div id="lightbox" role="dialog" aria-modal="true" aria-label="Imagen ampliada">
  <img id="lb-img" src="" alt="">
  <button id="lb-close" class="lb-btn" aria-label="Cerrar imagen">×</button>
  <button id="lb-prev" class="lb-btn" aria-label="Imagen anterior">‹</button>
  <button id="lb-next" class="lb-btn" aria-label="Imagen siguiente">›</button>
  <span id="lb-count" class="mono"></span>
</div>
<script>import '../scripts/main.ts';</script>
</body>
</html>
